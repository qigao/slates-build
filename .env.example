# Configure the Windows CMake bootstrap with ABI-matched SDKs.
# SALTS_BASE_ROOT=C:/sdks/salts-base-0.1.8
# SALTS_UTILS_ROOT=C:/sdks/salts-utils-0.1.6
# CMETA_ROOT=C:/sdks/cmeta-0.1.8
LLVM_MINGW_ROOT=C:/tools/llvm-mingw
CMAKE_BUILD_PARALLEL_LEVEL=3

# Required when selecting the debug-msvc example preset outside a developer shell.
# VSDEVCMD_BAT="C:/Program Files (x86)/Microsoft Visual Studio/2022/BuildTools/Common7/Tools/VsDevCmd.bat"
