{
    "include": ["presets/NativeToolchains.json", "presets/DefaultPreset.json"],
    "libraries": ["libraries/http.json"],
    "env": ["VSDEVCMD_BAT", "HTTP_SERVICES_ROOT", "SALTS_CNET_ROOT", "SALTS_BASE_ROOT", "SALTS_UTILS_ROOT"],
    "defaultPreset": "debug",
    "modules": ["hello"],
    "presets": {
        "debug-msvc": {
            "inherits": "debug",
            "targetPlatform": "windows-x64",
            "toolchain": "msvc-win64",
            "vsDevCmd": "${envPath:VSDEVCMD_BAT}"
        },
        "debug-mingw": {
            "inherits": "debug",
            "targetPlatform": "windows-x64",
            "toolchain": "llvm-mingw-x64"
        }
    }
}
